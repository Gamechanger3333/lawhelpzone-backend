# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=Cluster0

# ── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=your-strong-jwt-secret
JWT_REFRESH_SECRET=your-strong-refresh-secret

# ── AI (chat assistant + semantic search embeddings) ────────────────────────
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
# Only needed if running embeddings locally via Ollama instead of Gemini:
OLLAMA_URL=http://localhost:11434

# ── Email (verification, password reset) ─────────────────────────────────────
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
EMAIL_FROM_NAME=LawHelpZone

# ── Stripe (payments) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PLATFORM_FEE_PERCENTAGE=20

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Demo Account ─────────────────────────────────────────────────────────────
# Powers the "Try Demo Account" button on the login page. Data under this
# account resets automatically every time it logs in — see
# backend/scripts/seedDemoData.js for details. Real payments are hard-blocked
# for this account regardless of these values (see paymentRoutes.js).
DEMO_EMAIL=demo@lawhelpzone.com
DEMO_PASSWORD=Demo@1234

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
